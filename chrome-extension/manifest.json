{
  "manifest_version": 3,
  "name": "Operon Autopilot",
  "version": "1.0.0",
  "description": "Автоматический анализ рекламных кампаний — SCALE, KILL или WATCH прямо в браузере.",

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["https://adsmanager.facebook.com/*", "https://business.facebook.com/*", "https://ads.facebook.com/*"],
      "js": ["src/content/meta.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://ads.tiktok.com/*", "https://business.tiktok.com/*"],
      "js": ["src/content/tiktok.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab"
  ],

  "host_permissions": [
    "https://adsmanager.facebook.com/*",
    "https://business.facebook.com/*",
    "https://ads.facebook.com/*",
    "https://ads.tiktok.com/*",
    "https://business.tiktok.com/*",
    "https://operons.vercel.app/*",
    "http://localhost:3000/*"
  ],

  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
