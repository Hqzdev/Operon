generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AnalysisStage {
  testing
  scaling
  retesting
}

enum UserPlan {
  STARTER
  PRO
  SCALE
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELED
}

enum BillingSubscriptionStatus {
  active
  pending
  expired
  canceled
}

enum SubscriptionHistoryEvent {
  started
  renewed
  upgraded
  downgraded
  canceled
}

enum IntegrationProvider {
  META
  TIKTOK
  SHOPIFY
}

enum IntegrationStatus {
  CONNECTED
  ACTION_REQUIRED
  DISCONNECTED
  ERROR
}

enum NotificationType {
  digest
  alert
  info
}

enum FatigueSeverity {
  warning
  critical
}

enum FatigueAlertStatus {
  active
  dismissed
  snoozed
}

enum RedditIntentLevel {
  high
  medium
  low
}

enum AdActionType {
  pause
  increase_budget_20
  decrease_budget_20
  undo_budget_change
}

enum AdActionStatus {
  succeeded
  failed
  undone
}

enum RecommendationOutcomeStatus {
  pending
  evaluated
  unavailable
}

enum AgencyRole {
  owner
  member
  view_only
}

model User {
  id                  String             @id @default(cuid())
  email               String             @unique
  password            String
  name                String?
  avatarUrl           String?
  storeName           String?
  storeUrl            String?
  niche               String?
  quietModeEnabled    Boolean            @default(true)
  quietMinConfidence  String             @default("")
  quietMinSpendImpact Float              @default(-1)
  quietNoUrgentDigestAt DateTime?
  activeStoreId       String?
  onboardingCompleted Boolean            @default(false)
  plan                UserPlan           @default(STARTER)
  subscriptionStatus  SubscriptionStatus @default(NONE)
  subscriptionEndDate DateTime?
  usageCount          Int                @default(0)
  usageResetAt        DateTime           @default(now())
  createdAt           DateTime           @default(now())
  analyses            Analysis[]
  payments            Payment[]
  subscriptions       Subscription[]
  integrations        IntegrationConnection[]
  integrationMetrics  IntegrationMetricSnapshot[]
  seoAnalysis         SeoAnalysis?
  notifications       Notification[]
  digestLogs          DigestLog[]
  fatigueAlerts       FatigueAlert[]
  simulationLogs      SimulationLog[]
  adActionLogs        AdActionLog[]
  recommendationOutcomes RecommendationOutcome[]
  ownedAgencyWorkspaces AgencyWorkspace[] @relation("AgencyWorkspaceOwner")
  agencyMemberships   AgencyMember[]
  agencyClients       AgencyClient[]      @relation("AgencyClientUser")
  stores              Store[]            @relation("UserStores")
  activeStore         Store?             @relation("ActiveStore", fields: [activeStoreId], references: [id], onDelete: SetNull)
  killRecoveryListings KillRecoveryListing[]
}

model AgencyWorkspace {
  id        String         @id @default(cuid())
  ownerId   String
  name      String
  logoUrl   String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  owner     User           @relation("AgencyWorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   AgencyMember[]
  clients   AgencyClient[]
  reports   AgencyClientReport[]

  @@index([ownerId])
}

model AgencyMember {
  id              String           @id @default(cuid())
  workspaceId     String
  userId          String?
  clientId        String?
  role            AgencyRole
  invitedEmail    String?
  inviteToken     String?          @unique
  inviteExpiresAt DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  workspace       AgencyWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  client          AgencyClient?    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId, role])
  @@index([userId])
  @@index([clientId])
}

model AgencyClient {
  id          String               @id @default(cuid())
  workspaceId String
  userId      String?
  name        String
  contactEmail String?
  storeUrl    String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  workspace   AgencyWorkspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?               @relation("AgencyClientUser", fields: [userId], references: [id], onDelete: SetNull)
  members     AgencyMember[]
  reports     AgencyClientReport[]

  @@index([workspaceId, createdAt])
  @@index([userId])
}

model AgencyClientReport {
  id          String           @id @default(cuid())
  workspaceId String
  clientId    String
  weekStart   DateTime
  generatedAt DateTime         @default(now())
  summary     Json
  pdfBase64   String           @db.Text
  filename    String
  workspace   AgencyWorkspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client      AgencyClient     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, weekStart])
  @@index([workspaceId, generatedAt])
}

model Store {
  id             String   @id @default(cuid())
  userId         String
  name           String
  url            String
  platform       String?
  description    String?  @db.Text
  analysis       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation("UserStores", fields: [userId], references: [id], onDelete: Cascade)
  activeForUsers User[]   @relation("ActiveStore")

  @@unique([userId, url])
  @@index([userId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  body      String           @db.Text
  type      NotificationType @default(info)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, read])
}

model DigestLog {
  id      String   @id @default(cuid())
  userId  String
  sentAt  DateTime @default(now())
  summary Json
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
}

model FatigueAlert {
  id                String             @id @default(cuid())
  userId            String
  connectionId      String?
  provider          IntegrationProvider
  externalAccountId String
  externalEntityId  String
  creativeName      String
  severity          FatigueSeverity
  status            FatigueAlertStatus @default(active)
  triggeredMetrics  Json
  recommendation    String             @default("Pause or refresh creative")
  detectedAt        DateTime           @default(now())
  snoozeUntil       DateTime?
  dismissedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, detectedAt])
  @@index([userId, externalEntityId, detectedAt])
  @@index([provider, externalAccountId, externalEntityId])
}

model SimulationLog {
  id                String              @id @default(cuid())
  userId            String
  provider          IntegrationProvider
  externalAccountId String
  externalEntityId  String
  entityName        String?
  scenarios         Json
  baseline          Json
  confidence        Int
  signalBreakdown   Json
  actualOutcome     Json?
  createdAt         DateTime            @default(now())
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, externalEntityId, createdAt])
  @@index([provider, externalAccountId, externalEntityId])
}

model RedditLead {
  id             String            @id @default(cuid())
  redditPostId   String            @unique
  username       String
  subreddit      String
  postUrl        String
  title          String
  body           String?           @db.Text
  problemSummary String
  intentLevel    RedditIntentLevel
  outreachAngle  String            @db.Text
  painSignals    String[]
  score          Int               @default(0)
  upvotes        Int               @default(0)
  commentCount   Int               @default(0)
  postedAt       DateTime
  collectedAt    DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([postedAt, score])
  @@index([intentLevel, postedAt])
  @@index([subreddit, postedAt])
}

model Analysis {
  id        String        @id @default(cuid())
  userId    String
  stage     AnalysisStage
  inputData Json
  result    Json
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  adActionLogs AdActionLog[]
  recommendationOutcomes RecommendationOutcome[]
  killRecoveryListings KillRecoveryListing[]

  @@index([userId, createdAt])
}

model RecommendationOutcome {
  id                     String                      @id @default(cuid())
  userId                 String
  analysisId             String
  connectionId           String?
  provider               IntegrationProvider?
  externalAccountId      String?
  externalEntityId       String?
  entityName             String?
  inputSnapshot          Json
  verdict                String
  confidence             Int?
  breakEvenRoas          Float
  breakEvenCpa           Float?
  evaluationHorizonDays  Int
  scheduledFor           DateTime
  status                 RecommendationOutcomeStatus @default(pending)
  actualMetrics          Json?
  wasRight               Boolean?
  moneySaved             Float                       @default(0)
  moneyEarned            Float                       @default(0)
  evaluatedAt            DateTime?
  issuedAt               DateTime                    @default(now())
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  user                   User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis               Analysis                    @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  connection             IntegrationConnection?      @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@unique([analysisId, evaluationHorizonDays])
  @@index([userId, issuedAt])
  @@index([userId, status, scheduledFor])
  @@index([connectionId, externalEntityId, scheduledFor])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  plan              UserPlan
  amount            Int
  currency          String        @default("RUB")
  status            PaymentStatus @default(PENDING)
  provider          String        @default("yookassa")
  providerPaymentId String?       @unique
  confirmationUrl   String?
  customerName      String?
  cardLast4         String?
  country           String?
  approvedAt        DateTime?
  approvedBy        String?
  rejectedAt        DateTime?
  rejectedBy        String?
  rejectionReason   String?
  privateNotes      String?
  fraudFlags        String[]
  webhookPayload    Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs         PaymentAuditLog[]
  subscriptions     Subscription[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([providerPaymentId])
}

model Subscription {
  id           String                    @id @default(uuid())
  userId       String
  planId       String
  status       BillingSubscriptionStatus @default(pending)
  startDate    DateTime                  @default(now())
  renewDate    DateTime
  canceledDate DateTime?
  paymentId    String?
  renewalEmailSentAt DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment      Payment?                  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  history      SubscriptionHistory[]

  @@index([userId, status])
  @@index([status, renewDate])
  @@index([paymentId])
  @@map("subscriptions")
}

model SubscriptionHistory {
  id             String                   @id @default(uuid())
  subscriptionId String
  event          SubscriptionHistoryEvent
  planId         String
  amount         Decimal                  @db.Decimal(12, 2)
  currency       String                   @default("USD")
  status         String                   @default("Completed")
  createdAt      DateTime                 @default(now())
  subscription   Subscription             @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@map("subscription_history")
}

model PricingTier {
  id              String   @id @default(cuid())
  planId          String
  currency        String
  price           Decimal  @db.Decimal(12, 2)
  billingInterval String
  features        Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([planId, currency, billingInterval])
  @@index([currency, billingInterval])
  @@map("pricing_tiers")
}

model ExchangeRate {
  id            String   @id @default(cuid())
  baseCurrency  String
  quoteCurrency String
  rate          Decimal  @db.Decimal(18, 8)
  provider      String
  fetchedAt     DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([baseCurrency, quoteCurrency, fetchedAt])
  @@map("exchange_rates")
}

model PaymentAuditLog {
  id         String   @id @default(cuid())
  paymentId  String
  action     String
  adminId    String
  adminEmail String
  reason     String?
  notes      String?
  metadata   Json?
  createdAt  DateTime @default(now())
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@index([adminId, createdAt])
}

model EmailDeliveryLog {
  id        String    @id @default(uuid())
  template  String
  recipient String
  subject   String
  status    String
  provider  String    @default("smtp")
  attempts  Int       @default(0)
  error     String?   @db.Text
  metadata  Json?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([recipient, createdAt])
  @@index([template, status, createdAt])
  @@map("email_delivery_logs")
}

model Feature {
  id          String        @id @default(uuid())
  key         String        @unique
  name        String
  description String        @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")
  tiers       FeatureTier[]

  @@map("features")
}

model FeatureTier {
  id        String   @id @default(uuid())
  featureId String   @map("featureId")
  planId    String
  limit     Int?
  createdAt DateTime @default(now()) @map("created_at")
  feature   Feature  @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([featureId, planId])
  @@index([planId])
  @@map("feature_tiers")
}

model FeatureAccessLog {
  id        String   @id @default(uuid())
  userId    String
  featureKey String
  planId    String
  status    String
  reason    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, featureKey, createdAt])
  @@index([featureKey, status, createdAt])
  @@map("feature_access_logs")
}

model UpgradeMomentLog {
  id        String   @id @default(uuid())
  userId    String
  featureKey String
  fromPlanId String
  targetPlanId String
  source    String?
  createdAt DateTime @default(now())

  @@index([featureKey, createdAt])
  @@index([userId, createdAt])
  @@map("upgrade_moment_logs")
}

model IntegrationConnection {
  id                String              @id @default(cuid())
  userId            String
  provider          IntegrationProvider
  externalAccountId String
  accountName       String?
  accessToken       String              @db.Text
  refreshToken      String?             @db.Text
  tokenExpiresAt    DateTime?
  scopes            String[]
  status            IntegrationStatus   @default(CONNECTED)
  metadata          Json?
  lastSyncedAt      DateTime?
  nextSyncAt        DateTime            @default(now())
  syncLockUntil     DateTime?
  lastError         String?
  maxDailyBudgetChangePercent Int                 @default(20)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrics           IntegrationMetricSnapshot[]
  adActionLogs      AdActionLog[]
  recommendationOutcomes RecommendationOutcome[]

  @@unique([userId, provider, externalAccountId])
  @@index([userId, provider])
  @@index([nextSyncAt, status])
}

model IntegrationMetricSnapshot {
  id                String              @id @default(cuid())
  userId            String
  connectionId      String
  provider          IntegrationProvider
  externalAccountId String
  externalEntityId  String
  entityName        String?
  date              DateTime
  metrics           Json
  analysisInput     Json
  source            Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection        IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, externalAccountId, externalEntityId, date])
  @@index([userId, date])
  @@index([connectionId, date])
}

model AdActionLog {
  id                String              @id @default(cuid())
  userId            String
  connectionId      String
  provider          IntegrationProvider
  externalAccountId String
  externalEntityId  String
  entityName        String?
  verdictId         String?
  actionType        AdActionType
  status            AdActionStatus
  beforeState       Json
  afterState        Json?
  errorMessage      String?             @db.Text
  undoUntil         DateTime?
  undoneAt          DateTime?
  createdAt         DateTime            @default(now())
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection        IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  verdict           Analysis?           @relation(fields: [verdictId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([connectionId, externalEntityId, createdAt])
  @@index([verdictId])
}

model SeoAnalysis {
  id         String   @id @default(cuid())
  userId     String   @unique
  storeUrl   String
  result     Json
  analyzedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum KillRecoveryStatus {
  pending
  reviewing
  matched
  closed
}

model KillRecoveryListing {
  id               String              @id @default(cuid())
  userId           String
  analysisId       String?
  productName      String
  productPrice     Float
  cost             Float
  killReason       String              @db.Text
  mainProblem      String
  adAnglesTested   String[]
  totalSpendWasted Float?
  inventoryQty     Int?
  supplierUrl      String?
  status           KillRecoveryStatus  @default(pending)
  adminNotes       String?             @db.Text
  matchedAt        DateTime?
  revenueUsd       Float               @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis         Analysis?           @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}
