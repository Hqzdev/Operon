generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AnalysisStage {
  testing
  scaling
  retesting
}

enum UserPlan {
  STARTER
  PRO
  SCALE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELED
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  name      String?
  storeName String?
  plan      UserPlan   @default(STARTER)
  createdAt DateTime   @default(now())
  analyses  Analysis[]
  payments  Payment[]
}

model Analysis {
  id        String        @id @default(cuid())
  userId    String
  stage     AnalysisStage
  inputData Json
  result    Json
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  plan              UserPlan
  amount            Int
  currency          String        @default("RUB")
  status            PaymentStatus @default(PENDING)
  provider          String        @default("yookassa")
  providerPaymentId String?       @unique
  confirmationUrl   String?
  webhookPayload    Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
