generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AnalysisStage {
  testing
  scaling
  retesting
}

enum UserPlan {
  STARTER
  PRO
  SCALE
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELED
}

enum IntegrationProvider {
  META
  TIKTOK
  SHOPIFY
}

enum IntegrationStatus {
  CONNECTED
  ACTION_REQUIRED
  DISCONNECTED
  ERROR
}

model User {
  id                  String             @id @default(cuid())
  email               String             @unique
  password            String
  name                String?
  storeName           String?
  storeUrl            String?
  onboardingCompleted Boolean            @default(false)
  plan                UserPlan           @default(STARTER)
  subscriptionStatus  SubscriptionStatus @default(NONE)
  subscriptionEndDate DateTime?
  usageCount          Int                @default(0)
  usageResetAt        DateTime           @default(now())
  createdAt           DateTime           @default(now())
  analyses            Analysis[]
  payments            Payment[]
  integrations        IntegrationConnection[]
  integrationMetrics  IntegrationMetricSnapshot[]
  seoAnalysis         SeoAnalysis?
}

model Analysis {
  id        String        @id @default(cuid())
  userId    String
  stage     AnalysisStage
  inputData Json
  result    Json
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  plan              UserPlan
  amount            Int
  currency          String        @default("RUB")
  status            PaymentStatus @default(PENDING)
  provider          String        @default("yookassa")
  providerPaymentId String?       @unique
  confirmationUrl   String?
  webhookPayload    Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model IntegrationConnection {
  id                String              @id @default(cuid())
  userId            String
  provider          IntegrationProvider
  externalAccountId String
  accountName       String?
  accessToken       String              @db.Text
  refreshToken      String?             @db.Text
  tokenExpiresAt    DateTime?
  scopes            String[]
  status            IntegrationStatus   @default(CONNECTED)
  metadata          Json?
  lastSyncedAt      DateTime?
  nextSyncAt        DateTime            @default(now())
  syncLockUntil     DateTime?
  lastError         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrics           IntegrationMetricSnapshot[]

  @@unique([userId, provider, externalAccountId])
  @@index([userId, provider])
  @@index([nextSyncAt, status])
}

model IntegrationMetricSnapshot {
  id                String              @id @default(cuid())
  userId            String
  connectionId      String
  provider          IntegrationProvider
  externalAccountId String
  externalEntityId  String
  entityName        String?
  date              DateTime
  metrics           Json
  analysisInput     Json
  source            Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection        IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, externalAccountId, externalEntityId, date])
  @@index([userId, date])
  @@index([connectionId, date])
}

model SeoAnalysis {
  id         String   @id @default(cuid())
  userId     String   @unique
  storeUrl   String
  result     Json
  analyzedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
