generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AnalysisStage {
  testing
  scaling
  retesting
}

enum UserPlan {
  STARTER
  PRO
  SCALE
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELED
}

enum IntegrationProvider {
  META
  TIKTOK
  SHOPIFY
}

enum IntegrationStatus {
  CONNECTED
  ACTION_REQUIRED
  DISCONNECTED
  ERROR
}

enum NotificationType {
  digest
  alert
  info
}

enum FatigueSeverity {
  warning
  critical
}

enum FatigueAlertStatus {
  active
  dismissed
  snoozed
}

enum RedditIntentLevel {
  high
  medium
  low
}

model User {
  id                  String             @id @default(cuid())
  email               String             @unique
  password            String
  name                String?
  storeName           String?
  storeUrl            String?
  niche               String?
  activeStoreId       String?
  onboardingCompleted Boolean            @default(false)
  plan                UserPlan           @default(STARTER)
  subscriptionStatus  SubscriptionStatus @default(NONE)
  subscriptionEndDate DateTime?
  usageCount          Int                @default(0)
  usageResetAt        DateTime           @default(now())
  createdAt           DateTime           @default(now())
  analyses            Analysis[]
  payments            Payment[]
  integrations        IntegrationConnection[]
  integrationMetrics  IntegrationMetricSnapshot[]
  seoAnalysis         SeoAnalysis?
  notifications       Notification[]
  digestLogs          DigestLog[]
  fatigueAlerts       FatigueAlert[]
  simulationLogs      SimulationLog[]
  stores              Store[]            @relation("UserStores")
  activeStore         Store?             @relation("ActiveStore", fields: [activeStoreId], references: [id], onDelete: SetNull)
}

model Store {
  id             String   @id @default(cuid())
  userId         String
  name           String
  url            String
  platform       String?
  description    String?  @db.Text
  analysis       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation("UserStores", fields: [userId], references: [id], onDelete: Cascade)
  activeForUsers User[]   @relation("ActiveStore")

  @@unique([userId, url])
  @@index([userId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  body      String           @db.Text
  type      NotificationType @default(info)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, read])
}

model DigestLog {
  id      String   @id @default(cuid())
  userId  String
  sentAt  DateTime @default(now())
  summary Json
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
}

model FatigueAlert {
  id                String             @id @default(cuid())
  userId            String
  connectionId      String?
  provider          IntegrationProvider
  externalAccountId String
  externalEntityId  String
  creativeName      String
  severity          FatigueSeverity
  status            FatigueAlertStatus @default(active)
  triggeredMetrics  Json
  recommendation    String             @default("Pause or refresh creative")
  detectedAt        DateTime           @default(now())
  snoozeUntil       DateTime?
  dismissedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, detectedAt])
  @@index([userId, externalEntityId, detectedAt])
  @@index([provider, externalAccountId, externalEntityId])
}

model SimulationLog {
  id                String              @id @default(cuid())
  userId            String
  provider          IntegrationProvider
  externalAccountId String
  externalEntityId  String
  entityName        String?
  scenarios         Json
  baseline          Json
  confidence        Int
  signalBreakdown   Json
  actualOutcome     Json?
  createdAt         DateTime            @default(now())
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, externalEntityId, createdAt])
  @@index([provider, externalAccountId, externalEntityId])
}

model RedditLead {
  id             String            @id @default(cuid())
  redditPostId   String            @unique
  username       String
  subreddit      String
  postUrl        String
  title          String
  body           String?           @db.Text
  problemSummary String
  intentLevel    RedditIntentLevel
  outreachAngle  String            @db.Text
  painSignals    String[]
  score          Int               @default(0)
  upvotes        Int               @default(0)
  commentCount   Int               @default(0)
  postedAt       DateTime
  collectedAt    DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([postedAt, score])
  @@index([intentLevel, postedAt])
  @@index([subreddit, postedAt])
}

model Analysis {
  id        String        @id @default(cuid())
  userId    String
  stage     AnalysisStage
  inputData Json
  result    Json
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  plan              UserPlan
  amount            Int
  currency          String        @default("RUB")
  status            PaymentStatus @default(PENDING)
  provider          String        @default("yookassa")
  providerPaymentId String?       @unique
  confirmationUrl   String?
  webhookPayload    Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model IntegrationConnection {
  id                String              @id @default(cuid())
  userId            String
  provider          IntegrationProvider
  externalAccountId String
  accountName       String?
  accessToken       String              @db.Text
  refreshToken      String?             @db.Text
  tokenExpiresAt    DateTime?
  scopes            String[]
  status            IntegrationStatus   @default(CONNECTED)
  metadata          Json?
  lastSyncedAt      DateTime?
  nextSyncAt        DateTime            @default(now())
  syncLockUntil     DateTime?
  lastError         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrics           IntegrationMetricSnapshot[]

  @@unique([userId, provider, externalAccountId])
  @@index([userId, provider])
  @@index([nextSyncAt, status])
}

model IntegrationMetricSnapshot {
  id                String              @id @default(cuid())
  userId            String
  connectionId      String
  provider          IntegrationProvider
  externalAccountId String
  externalEntityId  String
  entityName        String?
  date              DateTime
  metrics           Json
  analysisInput     Json
  source            Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  connection        IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, externalAccountId, externalEntityId, date])
  @@index([userId, date])
  @@index([connectionId, date])
}

model SeoAnalysis {
  id         String   @id @default(cuid())
  userId     String   @unique
  storeUrl   String
  result     Json
  analyzedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
